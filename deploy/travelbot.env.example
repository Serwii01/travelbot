# Configuracion del bot en el VPS. install.sh la copia a /etc/travelbot.env (permisos 600).

# Token de @BotFather.
TELEGRAM_BOT_TOKEN=

# Token de Travelpayouts (panel -> Developers / API).
TRAVELPAYOUTS_TOKEN=
# Marker de afiliado (opcional): los enlaces de compra te generan comision.
TRAVELPAYOUTS_MARKER=

# No cambies esta ruta: es el StateDirectory del servicio systemd.
DATA_FILE=/var/lib/travelbot/db.json

DEFAULT_CURRENCY=EUR
# Cada cuantos minutos se comprueban precios (minimo 15). Los datos se refrescan cada ~48h.
CHECK_INTERVAL_MIN=180
# Bajada minima (%) para avisar cuando el precio sigue por encima de tu objetivo.
MIN_DROP_PCT=3
# Espera minima entre llamadas reales a Travelpayouts (ms).
REQUEST_DELAY_MS=1200
