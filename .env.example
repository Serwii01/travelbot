# ---- Telegram ----
# Token que te da @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=

# ---- Amadeus Self-Service (free tier) ----
# https://developers.amadeus.com  (Self-Service app -> API Key / API Secret)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# test.api.amadeus.com (gratis, datos limitados/cacheados) | api.amadeus.com (produccion)
AMADEUS_HOSTNAME=test.api.amadeus.com

# ---- Configuracion opcional ----
# Proveedor de vuelos: amadeus | mock
FLIGHT_PROVIDER=amadeus
# Driver de almacenamiento: json (unico implementado)
STORAGE_DRIVER=json
# Ruta del fichero de datos
DATA_FILE=data/db.json
# Moneda por defecto para nuevas alertas
DEFAULT_CURRENCY=EUR
# Espera entre llamadas a la API de vuelos (ms) para no pasarte de rate limit
REQUEST_DELAY_MS=1200
