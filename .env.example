# Para desarrollo local (npm run dev / npm run check).
# En el VPS se usa /etc/travelbot.env (plantilla en deploy/travelbot.env.example).

# ---- Telegram ----
# Token que te da @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=

# ---- Proveedor de vuelos ----
# travelpayouts (por defecto, gratis) | mock (precios inventados, sin API)
FLIGHT_PROVIDER=travelpayouts

# ---- Travelpayouts / Aviasales Data API (free tier, sin tarjeta) ----
# Token desde https://www.travelpayouts.com -> panel -> Developers / API.
TRAVELPAYOUTS_TOKEN=
# Marker de afiliado (opcional): se anade a los enlaces de compra.
TRAVELPAYOUTS_MARKER=

# ---- Configuracion opcional ----
# Ruta del fichero de datos
DATA_FILE=data/db.json
# Moneda por defecto para nuevas alertas
DEFAULT_CURRENCY=EUR
# Modo 24/7: cada cuantos minutos se comprueban precios (minimo 15)
CHECK_INTERVAL_MIN=180
# Bajada minima (%) para avisar cuando el precio sigue por encima del objetivo
MIN_DROP_PCT=3
# Espera minima entre llamadas reales a la API de vuelos (ms)
REQUEST_DELAY_MS=1200
